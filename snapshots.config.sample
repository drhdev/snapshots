# snapshots.py configuration
# Copy to 'snapshots.config' and adjust. Keep the file private: chmod 600 snapshots.config
# All paths are relative to the project directory.

# ============================================================================
# Directories and files
# ============================================================================
[DIRECTORIES]
# Directory with the server JSON files
configs_dir = configs
# Directory for the log file and the lock file
logs_dir = logs

[FILES]
log_file = snapshots.log
# Prevents two runs at the same time
lock_file = snapshots.lock

# ============================================================================
# Timing
# ============================================================================
[TIMING]
# Pause in seconds between two servers
delay_between_servers = 20
# Maximum time in seconds to wait for a snapshot to finish. Large servers can take
# well over 15 minutes. If the time runs out, the run counts as failed and no old
# snapshots are deleted; the next run cleans up as usual.
snapshot_creation_timeout = 3600
# Seconds between two status checks while a snapshot is being created
action_poll_interval = 15

# ============================================================================
# Logging
# ============================================================================
[LOGGING]
# Write a log file. Set to false to log to stderr only (e.g. journald when run
# by a systemd timer), which avoids writes to the SD card completely.
file_enabled = true
# DEBUG, INFO, WARNING, ERROR. INFO writes roughly 10 lines per server and run.
level = INFO
# Rotation: max size per file in bytes and number of old files kept.
# 1 MB with 2 backups = at most 3 MB on disk.
max_bytes = 1048576
backup_count = 2

# ============================================================================
# Telegram (global fallback)
# ============================================================================
# Used when a server JSON file has no own Telegram settings.
# Settings in the server JSON file take precedence.
[TELEGRAM]
enabled = true
bot_token =
chat_id =
# Request timeout in seconds, number of attempts and base delay for exponential
# backoff (2 -> waits 2s, 4s, 8s, ...)
timeout = 10
retries = 3
base_delay_between_retries = 2
# Message templates, use \n for line breaks. Leave empty for the built-in format.
# Placeholders: {script} {provider} {server_name} {server_id} {snapshot_name}
# {total_snapshots} {snapshot_info} {status} {hostname} {timestamp} {error}
message_success = *Snapshot Success*\nServer: `{server_name}`\nSnapshot: `{snapshot_name}`\nTotal: `{total_snapshots}` snapshots
message_failure = *Snapshot Failed*\nServer: `{server_name}`\nError: `{error}`

# ============================================================================
# Webhook (global fallback, e.g. n8n)
# ============================================================================
[WEBHOOK]
enabled = false
url =
timeout = 10
retries = 3
base_delay_between_retries = 2
# Optional JSON payload templates (one line, same placeholders as above).
# Leave empty for the built-in payload.
payload_success =
payload_failure =

# ============================================================================
# Heartbeat (e.g. Uptime Kuma push monitor)
# ============================================================================
# After every run the script calls this URL with status=up (all snapshots created)
# or status=down (at least one failed, configuration error or crash) and a short
# message. If the Pi or the script stops running, the push is missing and the
# monitor goes down on its own. See README, section "Heartbeat with Uptime Kuma".
[HEARTBEAT]
enabled = false
# Push URL from Uptime Kuma. Parameters copied along (?status=up&msg=OK&ping=) are
# replaced by the script, so the URL can be pasted as shown in Uptime Kuma.
url = https://uptime.example.com/api/push/your_push_token
timeout = 10
retries = 3
base_delay_between_retries = 2
